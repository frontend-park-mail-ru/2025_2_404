            <div class="info-page__contact-icon">
              <img src="/public/assets/mail.svg" alt="Email">
            </div>
            <div class="info-page__contact-content">
              <h4>Email</h4>
              <a href="mailto:adnet.website.sprt@internet.ru">adnet.website.sprt@internet.ru</a>
            </div>
          </div>
          
          <div class="info-page__contact-item">
            <div class="info-page__contact-icon">
              <img src="/public/assets/phone.svg" alt="Телефон">
            </div>
            <div class="info-page__contact-content">
              <h4>Телефон</h4>
              <a href="tel:+79532748634">8 (953) 274-86-34</a>
            </div>
          </div>
        </div>
        
