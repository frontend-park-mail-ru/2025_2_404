<div class="ads">
  {{#unless isNew}}
  <div class="ads__view-mode" id="ads-view-mode">
    <div class="ads__view-card">
      <img class="ads__view-image" src="{{project.image_url}}" alt="{{project.title}}">
      <h2 class="ads__view-title">{{project.title}}</h2>
      
      <div class="ads__view-info">
        {{#if project.description}}
        <div class="ads__view-row">
          <span class="ads__view-label">Описание:</span>
          <span class="ads__view-value">{{project.description}}</span>
        </div>
        {{/if}}
        
        {{#if project.domain}}
        <div class="ads__view-row">
          <span class="ads__view-label">Сайт:</span>
          <span class="ads__view-value">{{project.domain}}</span>
        </div>
        {{/if}}
        <div class="ads__view-row">
          <span class="ads__view-label">Бюджет:</span>
          <span class="ads__view-value" data-type="budget">{{project.budget}}₽</span>
        </div>

        <div class="ads__view-row">
          <span class="ads__view-label">Просмотры:</span>
          <span class="ads__view-value" data-type="impressions">{{project.impressions}}</span>
        </div>

        <div class="ads__view-row">
          <span class="ads__view-label">Клики:</span>
          <span class="ads__view-value" data-type="clicks">{{project.clicks}}</span>
        </div>

        {{!-- Временно скрыто пока бэкенд не исправит сохранение дат
        {{#if project.start_at}}
        <div class="ads__view-row">
          <span class="ads__view-label">Начало:</span>
          <span class="ads__view-value">{{formatDate project.start_at 'DD.MM.YYYY'}}</span>
        </div>
        {{/if}}
        
        {{#if project.end_at}}
        <div class="ads__view-row">
          <span class="ads__view-label">Окончание:</span>
          <span class="ads__view-value">{{formatDate project.end_at 'DD.MM.YYYY'}}</span>
        </div>
        {{/if}}
        --}}
      </div>

      <button class="btn btn--primary ads__view-edit-btn" id="ads-edit-btn">
        Редактировать
      </button>

      <div class="ads__view-actions">
        <button id="view-back-btn" class="btn btn--secondary">Назад к списку</button>
        <button id="view-delete-btn" class="btn btn--danger">Удалить</button>
      </div>
    </div>
  </div>
  {{/unless}}
  <div class="ads__form-card {{#if isNew}}is-create-mode{{/if}}" id="ads-edit-mode">
    
    {{#unless isNew}}
    <button class="ads__edit-back" id="ads-back-btn">
       <span class="breadcrumbs__separator">‹</span> Назад
    </button>
    {{/unless}}

    <h2 class="ads__title">
      {{#if isNew}}Создание кампании{{else}}Редактирование кампании{{/if}}
    </h2>
    
    <div class="ads__form">
      <form id="{{#if isNew}}create-form{{else}}edit-form{{/if}}">
        <label for="title-input">Заголовок</label>
        <input class="ads__item" id="title-input" type="text" value="{{project.title}}" placeholder="Введите заголовок">

        <label for="desc-input">Описание</label>
        <textarea id="desc-input" class="ads__item ads__description" placeholder="Введите описание">{{project.description}}</textarea>

        <label for="site-input">Ссылка на сайт</label>
        <input class="ads__item" id="site-input" type="url" value="{{project.domain}}" placeholder="Введите ссылку на сайт">
        <label for="budget-input">Бюджет</label>
        <div class="ads__input-group" style="display: flex; gap: 10px;">
          <input 
            class="ads__item" 
            id="budget-input" 
            type="number" 
            value="{{project.budget}}" 
            placeholder="Введите сумму" 
            min="0"
            style="flex-grow: 1; {{#unless isNew}}background-color: #f3f4f6; color: #666; cursor: not-allowed;{{/unless}}"
            {{#unless isNew}}readonly{{/unless}}
          >
          {{#unless isNew}}
            <button type="button" id="add-budget-btn" class="btn btn--secondary" style="font-weight: bold; font-size: 15px; padding: 0 13px;">
             +
            </button>
          {{/unless}}
        </div>
        
        
        {{!-- Временно скрыто пока бэкенд не исправит сохранение дат
        <label>Даты проведения</label>
        <div class="ads__dates">
          <input 
            class="ads__item" 
            id="start-date-input" 
            type="date" 
            value="{{formatDate project.start_at 'YYYY-MM-DD'}}"
          >
          <input 
            class="ads__item" 
            id="end-date-input" 
            type="date" 
            value="{{formatDate project.end_at 'YYYY-MM-DD'}}"
          >
        </div>
        --}}
        
        {{#unless isNew}}
          <div class="ads__status-wrapper" style="margin-top: 20px;">
            <div class="ads__status-row" style="display: flex; align-items: center; gap: 15px;">
              <label class="ads__status-label" style="margin-bottom: 0;">Статус объявления</label>
              <div class="ads__switch-group" style="display: flex; align-items: center;">
                <label class="switch">
                  <input type="checkbox" id="ad-status-toggle" 
                    {{#if isActive}}checked{{/if}} 
                    {{#if isLowBudget}}disabled{{/if}}
                  >
                  <span class="slider round"></span>
                </label>
                <span id="status-text" style="font-weight: bold; color: {{#if isActive}}#7C54E8{{else}}#A0AEC0{{/if}};">
                  {{#if isActive}}Активно{{else}}Приостановлено{{/if}}
                </span>
              </div>
            </div>
            <small id="status-lock-msg" style="color: #E53E3E; margin-top: 5px; display: {{#if isLowBudget}}block{{else}}none{{/if}};">
              Изменение статуса возможно только при бюджете больше 100₽
            </small>
          </div>

          <div class="ads__stats" style="margin-top: 20px; padding: 15px; background: #f8f9fa; border-radius: 8px;">
            <h4 style="margin: 0 0 10px 0; font-size: 14px; color: #666;">Статистика</h4>
            <div style="display: flex; gap: 30px;">
              <div>
                <span style="color: #888; font-size: 12px;">Просмотры</span>
                <div style="font-size: 18px; font-weight: bold; color: #333;">{{project.impressions}}</div>
              </div>
              <div>
                <span style="color: #888; font-size: 12px;">Клики</span>
                <div style="font-size: 18px; font-weight: bold; color: #7C54E8;">{{project.clicks}}</div>
              </div>
            </div>
          </div>
        {{/unless}}

        <div class="ads__img-upload">
          <label for="img-file" class="ads__upload-box" id="upload-box">
            <span class="ads__upload-icon">＋</span>
            <span class="ads__upload-text">Загрузите изображение</span>
            <input id="img-file" type="file" accept="image/jpeg, image/png" hidden />
          </label>
          <small class="ads__upload-hint">Поддерживаются JPG и PNG (до 10 МБ)</small>
          <small class="ads__upload-hint">Реклама может содержать только одно изображение</small>

        </div>
      </form>
    </div>

    <div class="ads__actions">
      {{#if isNew}}
        <button id="edit-btn" type="button" class="btn btn--primary">Создать кампанию</button>
      {{else}}
        <button id="edit-btn" type="button" class="btn btn--primary">Сохранить изменения</button>
      {{/if}}
      
      <div class="ads__actions-row">
        <button id="preview-toggle-btn" type="button" class="btn btn--outline ads__preview-toggle">Предпросмотр</button>
        <button id="back-btn" class="btn btn--secondary">Назад к списку</button>
      </div>

      {{#unless isNew}}
        <button id="delete-btn" type="button" class="btn btn--danger ads__delete-btn">Удалить</button>
      {{/unless}}
    </div>
  </div>
  <div class="ads__preview-card" id="ads-preview-card">
    <button id="preview-back-btn" type="button" class="ads__preview-back">
      <span class="breadcrumbs__separator">‹</span> Назад к форме
    </button>
    <h3>Предпросмотр</h3>
    <img class="ads__preview-image" src="{{project.image_url}}" />

    <h4>{{project.title}}</h4>
    <p>{{project.description}}</p>
  </div>

</div>